# See docs/deployment.md
INTERNAL_API_KEY=replace-with-the-same-value-used-by-the-api
# WORKER_CONCURRENCY=5
# Set to false to run this process without consuming queues (no Redis access).
# WORKER_QUEUES_ENABLED=true

# Recurring work. See docs/scheduled-jobs.md. Changing a cron takes effect on the
# next workers restart; no image rebuild is needed.
# STALE_CHECKOUT_RECONCILE_CRON=*/10 * * * *
# STALE_CHECKOUT_RECONCILE_LIMIT=50
# ORDER_QUOTE_CLEANUP_CRON=*/15 * * * *
# ORDER_QUOTE_CLEANUP_LIMIT=500
